# Agent Knowledge Exchange API — Environment Variables
# Copy this to .env and adjust values for your deployment.

# Database path (SQLite for dev, swap to Postgres URL for production)
DATABASE_URL=data/exchange.db

# CORS origins (comma-separated list of allowed origins)
CORS_ORIGINS=https://agentappstore.dev,http://localhost:3000,http://localhost:8000

# Server host and port (used by docker-compose)
HOST=0.0.0.0
PORT=8000

# Absolute path to registry.json. Leave unset when running from a repo checkout
# — the app walks up from app/registry.py to the repo root. Set it for packaged
# deployments where that relative walk does not land on the file; the Docker
# image sets it to /app/registry.json. If the registry fails to load the API
# still answers /health, but every POST /signals is rejected and the
# leaderboard is empty, so check "tools_known" in the /health response.
# REGISTRY_PATH=/app/registry.json
