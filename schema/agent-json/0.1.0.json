{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentappstore.dev/schema/agent-json/0.1.0",
  "title": "agent.json",
  "description": "Machine-readable manifest for AI agent service discovery. Published at /.well-known/agent.json",
  "type": "object",
  "required": ["spec_version", "name", "description"],
  "additionalProperties": true,
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version of the agent.json spec this manifest conforms to.",
      "examples": ["0.1.0"]
    },
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "description": "Human-readable service name."
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "1-3 sentence description optimized for LLM tool selection reasoning."
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "logo_url": {
      "type": "string",
      "format": "uri"
    },
    "contact": {
      "type": "string",
      "description": "Email address or URL for agent-related support issues."
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of capability slugs from the AgentStore Capability Taxonomy."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "languages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
      "description": "BCP 47 language tags for supported interface languages."
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["protocol"],
        "properties": {
          "protocol": {
            "type": "string",
            "enum": ["mcp", "rest", "openapi", "graphql", "grpc", "a2a", "custom"]
          },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "endpoint": { "type": "string" },
          "schema_url": { "type": "string", "format": "uri" },
          "docs_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "auth": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "api_key", "oauth2", "mtls", "custom"]
        },
        "key_header": { "type": "string" },
        "key_query_param": { "type": "string" },
        "key_cookie": { "type": "string" },
        "key_prefix": { "type": "string" },
        "key_acquisition_url": { "type": "string", "format": "uri" },
        "oauth2": {
          "type": "object",
          "properties": {
            "authorization_url": { "type": "string", "format": "uri" },
            "token_url": { "type": "string", "format": "uri" },
            "scopes": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "pkce_required": { "type": "boolean" }
          }
        }
      }
    },
    "rate_limits": {
      "type": "object",
      "properties": {
        "requests_per_minute": { "type": ["integer", "null"], "minimum": 0 },
        "requests_per_day": { "type": ["integer", "null"], "minimum": 0 },
        "tokens_per_minute": { "type": ["integer", "null"], "minimum": 0 },
        "burst_limit": { "type": ["integer", "null"], "minimum": 0 },
        "retry_after_header": { "type": "string" }
      }
    },
    "agent_hints": {
      "type": "object",
      "properties": {
        "preferred_invocation": {
          "type": "string",
          "enum": ["mcp", "rest", "openapi", "graphql", "grpc", "a2a", "custom"]
        },
        "idempotent_methods": {
          "type": "array",
          "items": { "type": "string", "enum": ["GET", "HEAD", "PUT", "DELETE", "OPTIONS"] }
        },
        "destructive_actions_require_confirmation": { "type": "boolean" },
        "max_concurrent_requests": { "type": "integer", "minimum": 1 },
        "supports_streaming": { "type": "boolean" },
        "supports_webhooks": { "type": "boolean" },
        "data_residency": { "type": "string" },
        "pii_in_requests": { "type": "boolean" }
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "enum": ["free", "per_request", "per_token", "subscription", "custom"]
        },
        "free_tier": { "type": "boolean" },
        "free_tier_details": { "type": "string" },
        "pricing_url": { "type": "string", "format": "uri" }
      }
    },
    "trust": {
      "type": "object",
      "properties": {
        "verified_by": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "certifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "terms_of_service_url": { "type": "string", "format": "uri" },
        "privacy_policy_url": { "type": "string", "format": "uri" },
        "agent_terms_url": { "type": "string", "format": "uri" }
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "listed_in": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "registry_ids": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["stable", "beta", "deprecated"]
    },
    "deprecated_at": { "type": ["string", "null"], "format": "date" },
    "sunset_date": { "type": ["string", "null"], "format": "date" },
    "changelog_url": { "type": "string", "format": "uri" }
  }
}
